# Copy to .env and fill in real values. Never commit .env.
# Hosted Postgres (Neon/Supabase) recommended for Phase 1.
# Neon: use the POOLED connection string (dashboard -> Connect -> pooled).
# Its transaction-mode pooler requires these suffix flags, otherwise Prisma
# throws on prepared statements and idle connections get killed (E57P01):
#   ?sslmode=require&pgbouncer=true&connection_limit=1

DATABASE_URL="postgresql://user:password@host:5432/mycareerarchive?schema=public"

# Backend
API_PORT=4000

# Rate limiting (per IP; health probes are exempt)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=100
RATE_LIMIT_API_MAX=600

# Logging: debug/info/warn/error/silent (default: debug locally, info in
# production, silent in tests)
LOG_LEVEL=

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth (Better Auth) — generate a fresh secret per environment
BETTER_AUTH_SECRET="paste-a-long-random-secret-here"
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Glob patterns (comma-separated, better-auth `*` syntax) trusted alongside
# WEB_ORIGIN by both Express CORS and better-auth — e.g. Vercel previews:
# WEB_ORIGIN_PATTERNS="https://mycareerarchive-*.vercel.app"
WEB_ORIGIN_PATTERNS=

# OAuth (Phase 4, Step 4) — leave empty until configured; providers
# activate from env alone. Redirect URIs registered with the providers:
#   Google: http://localhost:4000/api/auth/callback/google
#   GitHub: http://localhost:4000/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (verification + password reset via Brevo)
# No custom domain needed: verify a single sender address in Brevo
# (Settings -> Senders, Domains, IPs -> Senders -> Add sender, then paste
# the 6-digit code from its inbox). EMAIL_FROM must match that address.
# Free tier: 300 emails/day. Without BREVO_API_KEY the API logs the
# verification link instead of sending (dev/test fallback).
BREVO_API_KEY=
EMAIL_FROM="MyCareerArchive <you@gmail.com>"

# Evidence storage (S3-compatible, Phase 5) — pick ONE driver via
# STORAGE_DRIVER. Buckets must be PRIVATE. Bucket CORS must allow PUT from
# WEB_ORIGIN. Without the active driver's vars the API runs fine but storage
# routes answer 503 STORAGE_UNCONFIGURED.
STORAGE_DRIVER=supabase
# Driver "r2" (Cloudflare R2, needs card activation):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Driver "supabase" (Supabase Storage S3 protocol, free tier, no card):
# Dashboard -> Storage -> new PRIVATE bucket, then Storage -> S3 Access Keys
# -> Connect via S3 to copy Endpoint + Region and generate keys.
# Endpoint looks like https://<ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=evidence
# Max upload size in MB (default 25). Enforced at initiate (declared) and
# complete (real size via HeadObject).
EVIDENCE_MAX_MB=25

# Job matching (deterministic, no AI) — keys stay server-side, never in the
# frontend. Local PH search needs JSEARCH_API_KEY (OpenWeb Ninja JSearch,
# free 200 calls/month); without it /api/jobs/search answers 503
# JOBS_UNCONFIGURED for the local scope. International remote search uses the
# free Remotive public API (no key). Responses are cached 6h to protect quota.
JSEARCH_API_KEY=
