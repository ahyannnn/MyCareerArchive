# Copy to .env and fill in real values. Never commit .env.
# Hosted Postgres (Neon/Supabase) recommended for Phase 1.

DATABASE_URL="postgresql://user:password@host:5432/mycareerarchive?schema=public"

# Backend
API_PORT=4000

# Frontend
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Auth (Better Auth) — generate a fresh secret per environment
BETTER_AUTH_SECRET="paste-a-long-random-secret-here"
BETTER_AUTH_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# OAuth (Phase 4, Step 4) — leave empty until configured; providers
# activate from env alone. Redirect URIs registered with the providers:
#   Google: http://localhost:4000/api/auth/callback/google
#   GitHub: http://localhost:4000/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (verification + password reset via Resend)
# Dev needs no domain: without a verified domain, send from
# onboarding@resend.dev to your own account address for testing.
RESEND_API_KEY=
EMAIL_FROM="MyCareerArchive <onboarding@resend.dev>"

# Evidence storage (S3-compatible, Phase 5) — pick ONE driver via
# STORAGE_DRIVER. Buckets must be PRIVATE. Bucket CORS must allow PUT from
# WEB_ORIGIN. Without the active driver's vars the API runs fine but storage
# routes answer 503 STORAGE_UNCONFIGURED.
STORAGE_DRIVER=supabase
# Driver "r2" (Cloudflare R2, needs card activation):
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Driver "supabase" (Supabase Storage S3 protocol, free tier, no card):
# Dashboard -> Storage -> new PRIVATE bucket, then Storage -> S3 Access Keys
# -> Connect via S3 to copy Endpoint + Region and generate keys.
# Endpoint looks like https://<ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=evidence
# Max upload size in MB (default 25). Enforced at initiate (declared) and
# complete (real size via HeadObject).
EVIDENCE_MAX_MB=25
